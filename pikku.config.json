{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "packages/functions/src"
  ],
  "outDir": "packages/functions/.pikku",
  "remoteRpcWorkersFile": "packages/functions/src/pikku/rpc-remote.gen.ts",
  "workflowRoutesFile": "packages/functions/src/pikku/workflow-routes.gen.ts",
  "clientFiles": {
    "rpcMapDeclarationFile": "packages/sdk/src/pikku/rpc-map.gen.d.ts",
    "httpMapDeclarationFile": "packages/sdk/src/pikku/http-map.gen.d.ts",
    "fetchFile": "packages/sdk/src/pikku/pikku-fetch.gen.ts",
    "rpcWiringsFile": "packages/sdk/src/pikku/pikku-rpc.gen.ts",
    "reactQueryFile": "packages/sdk/src/pikku/api.gen.ts"
  },
  "packageMappings": {
    "packages/functions": "@project/functions"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "scaffold": {
    "pikkuDir": "packages/functions/src/pikku",
    "rpc": "no-auth",
    "console": "no-auth",
    "agent": "no-auth",
    "workflow": "no-auth"
  }
}
