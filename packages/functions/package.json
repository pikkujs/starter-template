{
  "name": "@project/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "//tsc": "No tsconfig of its own: the root tsconfig.json is the backend's, and it is found by directory lookup from here — which is also how `pikku cloud verify` runs it. Without this script `bun run --filter '*' tsc` matches on script NAME and silently skips the whole backend.",
    "tsc": "tsc --noEmit",
    "db:types": "pikku db types"
  },
  "dependencies": {
    "@pikku/addon-admin": "^0.12.15",
    "@pikku/addon-console": "^0.12.68",
    "@pikku/better-auth": "0.12.62",
    "@pikku/core": "0.12.154",
    "@pikku/kysely": "0.13.42",
    "@pikku/schema-cfworker": "^0.12.9",
    "@pikku/ws": "^0.12.11",
    "@standard-schema/spec": "^1.1.0",
    "better-auth": "^1.7.6",
    "kysely": "^0.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pikku/playwright": "^0.12.89",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
