{
  "name": "@project/functions",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "imports": {
    "#pikku": "./.pikku/pikku-types.gen.ts",
    "#pikku/*": "./.pikku/*"
  },
  "exports": {
    "./.pikku/*": "./.pikku/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx ../../node_modules/@pikku/cli/dist/bin/pikku.js dev -p 4003",
    "dbmigrate": "node --env-file-if-exists=.env --import tsx bin/db-migrate.ts",
    "db:types": "kysely-codegen --dialect postgres --camel-case --default-schema app --url $DATABASE_URL --out-file src/types/db.types.ts"
  },
  "dependencies": {
    "@pikku/addon-console": "^0.12.8",
    "@pikku/core": "^0.12.19",
    "@pikku/express": "^0.12.5",
    "@pikku/kysely-postgres": "^0.12.7",
    "@pikku/schedule": "^0.12.2",
    "@pikku/schema-cfworker": "^0.12.2",
    "@pikku/uws": "^0.12.4",
    "@pikku/ws": "^0.12.2",
    "kysely": "^0.28.12",
    "pg": "^8.16.0",
    "postgres-migrations": "^5.3.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pikku/cloudflare": "^0.12.6",
    "@pikku/deploy-cloudflare": "^0.12.1",
    "@pikku/deploy-standalone": "^0.12.2",
    "kysely-codegen": "^0.20.0"
  }
}
