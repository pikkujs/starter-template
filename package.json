{
  "name": "@project/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*",
    "!apps/_app_template_"
  ],
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bunx --bun pikku dev",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@pikku/bun-server": "^0.12.15",
    "@pikku/core": "0.12.154",
    "@pikku/kysely": "0.13.42",
    "@pikku/kysely-bun-sqlite": "^0.12.11",
    "@pikku/schedule": "^0.12.12"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.208",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
