{
  "name": "@project/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*",
    "!apps/_app_template_"
  ],
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun scripts/dev.mjs",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/openai-compatible": "^2.0.66",
    "@pikku/addon-admin": "^0.12.6",
    "@pikku/addon-console": "^0.12.53",
    "@pikku/ai-vercel": "^0.12.14",
    "@pikku/assistant-ui": "^0.12.13",
    "@pikku/better-auth": "^0.12.42",
    "@pikku/cloudflare": "^0.12.23",
    "@pikku/core": "0.12.111",
    "@pikku/fetch": "0.12.12",
    "@pikku/kysely": "^0.13.27",
    "@pikku/kysely-node-sqlite": "^0.12.8",
    "@pikku/kysely-sqlite": "^0.12.14",
    "@pikku/mantine": "^0.12.14",
    "@pikku/react": "^0.12.12",
    "@pikku/schema-cfworker": "^0.12.7",
    "ai": "^6.0.248"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.153",
    "@types/node": "^24",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@pikku/cli": "0.12.153",
    "@pikku/core": "0.12.111",
    "@pikku/deploy": "0.12.10",
    "@pikku/fetch": "0.12.12",
    "@pikku/knowledge": "0.12.14",
    "@pikku/kysely": "0.13.27",
    "@pikku/ws": "0.12.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.1"
}
