{
  "name": "@project/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*",
    "!apps/_app_template_"
  ],
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bunx --bun pikku dev",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@pikku/addon-admin": "^0.12.15",
    "@pikku/addon-console": "^0.12.68",
    "@pikku/ai-vercel": "^0.12.16",
    "@pikku/assistant-ui": "^0.12.14",
    "@pikku/better-auth": "^0.12.62",
    "@pikku/bun-server": "^0.12.15",
    "@pikku/core": "0.12.152",
    "@pikku/fetch": "0.12.14",
    "@pikku/kysely": "0.13.41",
    "@pikku/kysely-bun-sqlite": "^0.12.11",
    "@pikku/kysely-sqlite": "^0.12.18",
    "@pikku/react": "^0.12.20",
    "@pikku/schedule": "^0.12.12",
    "@pikku/schema-cfworker": "^0.12.9",
    "ai": "^7.0.165",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.205",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
